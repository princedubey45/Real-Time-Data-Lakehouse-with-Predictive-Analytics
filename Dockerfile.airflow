FROM apache/airflow:2.9.1-python3.11

USER root

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Copy requirements
COPY requirements.txt /tmp/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Copy project files
COPY --chown=airflow:root ./airflow/dags /opt/airflow/dags
COPY --chown=airflow:root ./api_ingestion /opt/airflow/api_ingestion
COPY --chown=airflow:root ./etl /opt/airflow/etl
COPY --chown=airflow:root ./anomaly_detection /opt/airflow/anomaly_detection
COPY --chown=airflow:root ./forecasting /opt/airflow/forecasting
COPY --chown=airflow:root ./config.py /opt/airflow/config.py

# Initialize Airflow database and create admin user
RUN airflow db init && \
    airflow users create \
    --username admin \
    --password admin \
    --firstname Admin \
    --lastname User \
    --role Admin \
    --email admin@example.com

# Expose port
EXPOSE 8080

# Start webserver
CMD ["airflow", "webserver"]
