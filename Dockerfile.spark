# Dockerfile.spark
# ══════════════════════════════════════════════════════════════════
#  Custom Spark image for the Enterprise Data Platform
#  Base : bitnamilegacy/spark:3.5.1
#  Adds : hadoop-aws S3A connector JAR for MinIO read/write
#          Python deps (pyspark, pyarrow, boto3, psycopg2)
# ══════════════════════════════════════════════════════════════════

FROM bitnamilegacy/spark:3.5.1

USER root

# ── System dependencies ────────────────────────────────────────────
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        curl wget python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ── S3A / Hadoop-AWS JARs (required to access MinIO via s3a://) ───
# These versions MUST match the Hadoop version bundled with Spark 3.5
ENV HADOOP_VERSION=3.3.4
ENV AWS_SDK_VERSION=1.12.262
ENV SPARK_HOME=/opt/bitnami/spark

RUN wget -q -P ${SPARK_HOME}/jars/ \
    "https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/${HADOOP_VERSION}/hadoop-aws-${HADOOP_VERSION}.jar" && \
    wget -q -P ${SPARK_HOME}/jars/ \
    "https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/${AWS_SDK_VERSION}/aws-java-sdk-bundle-${AWS_SDK_VERSION}.jar"

# ── Python packages ───────────────────────────────────────────────
RUN pip3 install --no-cache-dir \
    pyspark==3.5.1 \
    pyarrow==16.1.0 \
    boto3==1.34.120 \
    psycopg2-binary==2.9.9 \
    pandas==2.2.2 \
    requests==2.32.3 \
    kafka-python==2.0.2 \
    confluent-kafka==2.4.0

# ── Copy Spark job modules into the image ─────────────────────────
COPY spark/          /opt/spark-jobs/spark/
COPY config.py       /opt/spark-jobs/config.py
COPY kafka_streaming/ /opt/spark-jobs/kafka_streaming/

ENV PYTHONPATH="/opt/spark-jobs:${PYTHONPATH}"

USER 1001

# Default: start as Spark worker (overridden in docker-compose)
CMD ["/opt/bitnami/scripts/spark/run.sh"]
